{
  "name": "drama-kids-canterbury",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc && tsc -p api",
    "api:dev": "wrangler dev --config api/wrangler.jsonc --port 8787",
    "api:deploy": "wrangler deploy --config api/wrangler.jsonc",
    "api:db:generate": "drizzle-kit generate --config api/drizzle.config.ts",
    "api:db:migrate:local": "wrangler d1 migrations apply drama-kids --local --config api/wrangler.jsonc",
    "api:db:migrate:remote": "wrangler d1 migrations apply drama-kids --remote --config api/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hono/zod-validator": "^0.9.1",
    "@react-router/node": "^8.5.0",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "hono": "^4.13.14",
    "isbot": "^5.2.2",
    "jose": "^6.2.14",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "stripe": "^23.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-imagetools": "^12.0.1",
    "wrangler": "^4.156.0"
  }
}
