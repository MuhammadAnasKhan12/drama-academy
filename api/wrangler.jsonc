// Cloudflare Worker for the Drama Kids booking API.
// Local:  npm run api:dev        Deploy: npm run api:deploy   (see api/README.md)
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "drama-kids-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drama-kids",
      // Replace with the id printed by `npx wrangler d1 create drama-kids` before deploying
      "database_id": "6252caa0-fc0b-4c79-b8f3-ef8cd6655762",
      "migrations_dir": "migrations"
    }
  ],

  // Every 15 minutes: release places held by payments that were never completed
  "triggers": { "crons": ["*/15 * * * *"] },

  // The API's addresses on the club's domain (the domain must be active on Cloudflare first).
  // The website calls /api on its own address, so the admin's sign-in cookie
  // is sent with admin requests. api.… stays for the Stripe webhook.
  "routes": [
    { "pattern": "api.dramakidscanterbury.co.uk", "custom_domain": true },
    { "pattern": "dramakidscanterbury.co.uk/api/*", "zone_name": "dramakidscanterbury.co.uk" },
    { "pattern": "www.dramakidscanterbury.co.uk/api/*", "zone_name": "dramakidscanterbury.co.uk" }
  ],

  // Non-secret settings. Secrets (Stripe, Resend, admin sign-in) go in .dev.vars locally and `wrangler secret put` in production.
  "vars": {
    // Comma-separated list of sites allowed to call the API
    "SITE_ORIGIN": "http://localhost:5199,https://dramakidscanterbury.co.uk,https://www.dramakidscanterbury.co.uk",
    // How long places are held while a parent pays
    "HOLD_MINUTES": "30",
    // Who booking notifications go to, and who emails are sent from (domain must be verified in Resend)
    "ADMIN_NOTIFY_EMAIL": "canterbury@dramakids.co.uk",
    "EMAIL_FROM": "Drama Kids Canterbury <bookings@example.com>"
  }
}
