# Copy this file to `.env` and fill in the values.

# Stripe *publishable* key (starts with pk_test_ for testing, pk_live_ when live).
# Stripe Dashboard -> Developers -> API keys. Safe to use in the browser.
# NEVER put a secret (sk_) or restricted (rk_) key here - those belong in api/.dev.vars only.
VITE_STRIPE_PUBLISHABLE_KEY=

# Booking API address. Locally: http://localhost:8787/api (run `npm run api:dev`).
# In production: https://<your-worker>.workers.dev/api or https://yourdomain/api
# Leave empty for demo mode (no payments, sample admin data).
VITE_BOOKING_API_URL=
